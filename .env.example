# Copy this file to .env.local and fill it in.

# Address of the live site (used for canonical links).
NEXT_PUBLIC_SITE_URL=https://publisher4states.com/
# Where every enquiry form sends its fields (POST, FormData).
# This is your CRM / lead service URL. The site has no PHP or API of its own any more.
# When it is empty the forms show "not connected yet" instead of losing the lead.
NEXT_PUBLIC_LEAD_ENDPOINT=
